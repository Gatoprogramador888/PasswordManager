{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://127.0.0.1:5500",
    "http://localhost:5500",
    "https://127.0.0.1:5500",
    "https://localhost:5500"
  ],
  "ConnectionStrings": {
    "MySQL": "YOUR_MYSQL_CONNECTION_STRING",
    "Redis": "YOUR_REDIS_CONNECTION_STRING"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS",
    "Issuer": "password-manager-api",
    "Audience": "password-manager-client"
  }
}